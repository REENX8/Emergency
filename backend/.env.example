# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# ── Database ─────────────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string (from Project Settings → Database → URI)
# Leave blank to use local SQLite (evacuation.db) for development.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# ── Supabase Storage ──────────────────────────────────────────────────────────
# Project URL (from Project Settings → API)
SUPABASE_URL=https://[PROJECT_REF].supabase.co

# Service Role Key — NOT the anon key. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Storage bucket name (create this in Supabase Dashboard → Storage)
SUPABASE_BUCKET=floor-plans

# ── Optional overrides ────────────────────────────────────────────────────────
# Uncomment to change the API port (default: 8000)
# PORT=8000
